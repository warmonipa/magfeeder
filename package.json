{
  "name": "magfeeder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate_data.mjs && ng serve --host 127.0.0.1 --port 5173",
    "preview": "node scripts/serve_site.mjs _site 4174",
    "build": "node scripts/build_site.mjs",
    "sync:data": "node scripts/sync_mag_data.mjs",
    "test": "npm run test:i18n && node scripts/verify_mag_data_sync.mjs && node scripts/verify_mag_sim_data.mjs && node scripts/verify_mag_sim.mjs && node scripts/verify_mag_sim_planner.mjs && node scripts/verify_angular_architecture.mjs",
    "test:e2e": "playwright test",
    "release:prepare": "npm test && npm run build && npm run test:e2e",
    "sync:i18n": "node scripts/sync_item_i18n.mjs",
    "test:i18n": "node --test scripts/test_item_i18n.mjs && node scripts/sync_item_i18n.mjs --check",
    "generate:data": "node scripts/generate_data.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.3"
    },
    "@angular/cli": {
      "@modelcontextprotocol/sdk": "1.30.0"
    },
    "@hono/node-server": "2.1.0"
  }
}
